<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:name="vector"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
        کاریا: نمادِ نوارِ وضعیت (کنارِ آنتن) — حرفِ K کاریا با گوشیِ تلفن.

        ⚠️ اندروید این آیکون را تخت و تک‌رنگ می‌کشد و فقط آلفا را می‌بیند؛ هر رنگی
        این‌جا بگذاریم خودش سفیدش می‌کند. برای همین طرح باید سیلوئتِ توپر باشد،
        نه خطیِ نازک، وگرنه در ۲۴dp یک لکه‌ی نامفهوم می‌شود.

        K سمتِ چپ جمع شده و گوشی سمتِ راستِ پایین ایستاده تا دو شکل در هم نروند.
    -->
    <group android:name="group">
        <!-- ساقِ عمودیِ K -->
        <path
            android:name="k_stem"
            android:pathData="M2.6,2.8 L5.6,2.8 L4.4,21.2 L1.4,21.2 Z"
            android:fillColor="#ffffff"/>
        <!-- بازوی بالاییِ K -->
        <path
            android:name="k_upper"
            android:pathData="M11.4,2.8 L14.4,2.8 L6.8,11.4 L6.2,8.6 Z"
            android:fillColor="#ffffff"/>
        <!-- بازوی پایینِ K -->
        <path
            android:name="k_lower"
            android:pathData="M6.4,12.0 L8.2,10.2 L11.6,15.4 L9.0,17.0 Z"
            android:fillColor="#ffffff"/>
        <!-- گوشیِ تلفن (سیلوئتِ توپر، مایل رو به پایین-راست) -->
        <path
            android:name="handset"
            android:pathData="M16.9,8.2 C18.1,7.5 19.6,7.9 20.3,9.1 L21.2,10.7 C21.9,11.9 21.5,13.4 20.3,14.1 L19.2,12.2 C18.6,12.6 18.1,13.1 17.7,13.7 L19.6,14.8 C18.9,16.0 17.4,16.4 16.2,15.7 L14.6,14.8 C13.4,14.1 13.0,12.6 13.7,11.4 C14.5,10.1 15.6,9.0 16.9,8.2 Z"
            android:fillColor="#ffffff"/>
    </group>
</vector>
